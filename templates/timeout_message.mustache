{{!
    Timeout warning with retry button shown when polling times out.
    @template block_dixeo_tutor/timeout_message

    Example context (json):
    {
        "message": "The response is taking longer than expected.",
        "checklabel": "Check for updates"
    }
}}
<div class="d-flex justify-content-center mb-2">
    <div class="dixeo-tutor-message dixeo-tutor-message-system alert alert-warning d-inline-flex flex-column">
        <div>{{message}}</div>
        <button type="button" class="btn btn-sm btn-outline-primary mt-2 dixeo-tutor-timeout-retry">
            <i class="icon fa fa-refresh" aria-hidden="true"></i> {{checklabel}}
        </button>
    </div>
</div>
