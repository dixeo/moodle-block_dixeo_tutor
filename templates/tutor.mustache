{{!
    Dixeo Student Tutor chat shell (messages are rendered by AMD).
    @template block_dixeo_tutor/tutor

    Example context (json):
    {
        "coursename": "Course name",
        "currentcmid": 0
    }
}}
<div id="dixeo-tutor" class="card border-0 shadow d-flex flex-column"
     data-course-name="{{coursename}}"
     data-current-cmid="{{currentcmid}}"
     data-generation-languages="{{generationlanguagesjson}}"
     data-default-generation-language="{{defaultgenerationlanguage}}"
     data-quiz-mode-available="{{#quizmodeavailable}}1{{/quizmodeavailable}}{{^quizmodeavailable}}0{{/quizmodeavailable}}"
     data-teach-mode-available="{{#teachmodeavailable}}1{{/teachmodeavailable}}{{^teachmodeavailable}}0{{/teachmodeavailable}}"
     data-tutor-mode="{{#mode_selector}}{{currentmode}}{{/mode_selector}}{{^mode_selector}}normal{{/mode_selector}}">
    <div class="card-header d-flex flex-nowrap align-items-center bg-light px-3 py-2" id="dixeo-tutor-header">
        <span class="font-weight-bold dixeo-tutor-title">{{#str}}assistanttitle, block_dixeo_tutor{{/str}}</span>
        <div class="dixeo-tutor-header__end">
            {{#mode_selector}}
            {{> block_dixeo_tutor/mode_selector }}
            {{/mode_selector}}
            <button type="button"
                    id="dixeo-tutor-delete"
                    class="btn btn-link p-1 dixeo-tutor-delete"
                    title="{{#str}}deleteconversation, block_dixeo_tutor{{/str}}"
                    aria-label="{{#str}}deleteconversation, block_dixeo_tutor{{/str}}"
                    disabled>
                <i class="fa fa-trash-o" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <div class="card-body p-0 d-flex flex-column flex-grow-1 dixeo-tutor-body" id="dixeo-tutor-body">
        <div class="dixeo-guide-banner" role="region" aria-label="{{#str}}guide_banner_title, block_dixeo_tutor{{/str}}">
            <div class="dixeo-guide-banner__title-wrap">
                <h5 class="dixeo-guide-banner__title mb-0">{{#str}}guide_banner_title, block_dixeo_tutor{{/str}}</h5>
                <button type="button"
                        class="dixeo-guide-banner__help"
                        aria-describedby="dixeo-guide-help-tip"
                        aria-label="{{#str}}guide_banner_help_label, block_dixeo_tutor{{/str}}">
                    <i class="fa fa-question-circle" aria-hidden="true"></i>
                </button>
                <span id="dixeo-guide-help-tip" class="dixeo-guide-banner__help-tip" role="tooltip">
                    {{#str}}guide_banner_help, block_dixeo_tutor{{/str}}
                </span>
            </div>
            <div class="dixeo-guide-banner__actions">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-action="exit-guide"
                        title="{{#str}}guide_banner_exit, block_dixeo_tutor{{/str}}"
                        aria-label="{{#str}}guide_banner_exit, block_dixeo_tutor{{/str}}">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div id="dixeo-tutor-quiz-pane" class="dixeo-tutor-quiz-pane d-none" aria-hidden="true"></div>
        <div id="dixeo-tutor-teach-pane" class="dixeo-tutor-teach-pane d-none" aria-hidden="true"></div>
        <div id="dixeo-tutor-chat-pane" class="dixeo-tutor-chat-pane d-flex flex-column flex-grow-1">
            <div class="card-body p-2 d-flex flex-column flex-grow-1" id="dixeo-tutor-messages">
                <!-- Messages will be appended here. -->
            </div>
            <div class="card-footer p-2 dixeo-tutor-composer" id="dixeo-tutor-composer">
                <div class="d-flex">
                    <textarea id="dixeo-tutor-input"
                              class="form-control"
                              placeholder="{{#str}}placeholder, block_dixeo_tutor{{/str}}"
                              aria-label="{{#str}}placeholder, block_dixeo_tutor{{/str}}"></textarea>
                    <button id="dixeo-tutor-send" class="btn btn-primary px-2">
                        <i class="fa fa-paper-plane" aria-hidden="true"></i>
                        <span class="sr-only">{{#str}}send, block_dixeo_tutor{{/str}}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
