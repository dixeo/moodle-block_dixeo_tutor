{{!
    @template block_dixeo_tutor/practice_quiz_review

    Compact practice quiz review card embedded in chat.

    Example context (json):
    {
        "version": 1,
        "label": "Practice quiz",
        "title": "Avicii biography",
        "detailsLabel": "View quiz results",
        "hasIntro": true,
        "introHtml": "<p>A short quiz about Avicii.</p>",
        "bestScoreLabel": "Best score: 1/1 (100%)",
        "showExitScore": false,
        "exitScoreLabel": "This attempt: 1/1 (100%)",
        "canRetake": true,
        "retakeLabel": "Retake quiz"
    }
}}
<div class="card dixeo-practice-quiz-review" data-review-version="{{version}}">
    <div class="card-header dixeo-practice-quiz-review__header">
        <p class="dixeo-practice-quiz-review__mode-label mb-0">{{label}}</p>
        <h4 class="card-title dixeo-practice-quiz-review__title mb-0">{{title}}</h4>
    </div>
    <div class="card-body dixeo-practice-quiz-review__body">
        {{#hasIntro}}
        <div class="dixeo-practice-quiz-review__intro">{{{introHtml}}}</div>
        {{/hasIntro}}
        <p class="dixeo-practice-quiz-review__best-score mb-0">{{bestScoreLabel}}</p>
        {{#showExitScore}}
        <p class="dixeo-practice-quiz-review__exit-score mb-0">{{exitScoreLabel}}</p>
        {{/showExitScore}}
    </div>
    <div class="card-footer dixeo-practice-quiz-review__footer">
        <button type="button"
                class="dixeo-practice-quiz-review__details-btn"
                data-action="view-review-details"
                aria-label="{{detailsLabel}}"
                title="{{detailsLabel}}">
            <i class="fa fa-question dixeo-practice-quiz-review__details-icon" aria-hidden="true"></i>
        </button>
        {{#canRetake}}
        <button type="button"
                class="btn btn-sm btn-outline-secondary dixeo-practice-quiz-review__retake-btn"
                data-action="retake-quiz">
            {{retakeLabel}}
        </button>
        {{/canRetake}}
    </div>
</div>
